[Unit]
Description=Game of Lifer (static site for lifer.taridepaco.com.es)
After=network-online.target
Wants=network-online.target

[Service]
User=lifer
Group=lifer
WorkingDirectory=/opt/lifer
# Only reachable through the Cloudflare tunnel: bind to localhost
ExecStart=/usr/bin/python3 -m http.server 8003 --bind 127.0.0.1 --directory /opt/lifer
Restart=always
RestartSec=5

# Isolation. Static, read-only site: no ReadWritePaths.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
# empty /mnt (no Windows drives) except DNS: in WSL /etc/resolv.conf points to /mnt/wsl/resolv.conf
TemporaryFileSystem=/mnt:ro
BindReadOnlyPaths=/mnt/wsl/resolv.conf
InaccessiblePaths=/init
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077

[Install]
WantedBy=multi-user.target
